$TTL    86400
@       IN      SOA     ns1.example.local. admin.example.local. (
                        2024010101         ; Serial
                        3600               ; Refresh
                        1800               ; Retry
                        604800             ; Expire
                        86400 )            ; Negative Cache TTL

@       IN      NS      ns1.example.local.
ns1     IN      A       192.168.1.1
